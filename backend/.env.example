# Groq — get keys at console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Supabase — get values at supabase.com → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role key (never expose to frontend)
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings → API → JWT Settings → JWT Secret

# HuggingFace — get token at huggingface.co/settings/tokens (free account)
HUGGINGFACE_API_KEY=hf_...

# CORS — comma-separated list of allowed frontend origins
# For production: set to your Vercel URL, e.g. https://transcripts-simple.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
